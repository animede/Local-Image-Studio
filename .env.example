# Local-only defaults. Copy this file to .env only if your process manager loads it.
QWEN_DEVICE=cuda:0
QWEN_START_PROFILE=turbo
QWEN_QUANTIZATION=nvfp4
QWEN_ACCELERATION=viggle-r128
QWEN_CPU_OFFLOAD=0
QWEN_REFERENCE_MODE=adaptive
QWEN_VAE_TILING=1
QWEN_TRIM_CUDA_CACHE=1
QWEN_API_HOST=127.0.0.1
QWEN_API_PORT=8000
QWEN_FRONTEND_HOST=127.0.0.1
QWEN_FRONTEND_PORT=5173
